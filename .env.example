# --- LLM: Claude via Azure AI Foundry (Sonnet 5 default; Opus 4.8 / Fable 5) ---
# Option A (preferred): Microsoft Azure AI Foundry.
# Must end in /anthropic/v1 — the provider appends /messages to it.
ANTHROPIC_FOUNDRY_BASE_URL=https://<resource>.services.ai.azure.com/anthropic/v1
ANTHROPIC_FOUNDRY_API_KEY=

# Option B (fallback, used when the Foundry URL is unset): direct Anthropic API
ANTHROPIC_API_KEY=

# --- Extra models (any OpenAI-compatible /v1 endpoint: Ollama, OpenAI, Groq,
#     vLLM, OpenRouter, Gemini's compat endpoint, …) ---
# JSON array; each entry: id (app-unique), label, and for openai-compatible
# entries a baseUrl. Optional: hint (picker subtitle), provider (logo family:
# anthropic/openai/google/qwen/ollama, else generic), model (upstream name when
# it differs from id), apiKey or apiKeyEnv (name of the env var holding the
# key — Ollama needs neither), reasoningTag ("think" extracts <think>…</think>
# from reasoning models like Qwen/DeepSeek so the UI shows it as thinking),
# maxOutputTokens (per-request output ceiling; default 8192 for
# openai-compatible entries — a runaway reasoning loop on CPU churns for
# minutes otherwise — and 32000 for anthropic ones).
# The built-in Claude entries appear only when Anthropic credentials are set
# above; MODELS_EXTRA entries are appended after them.
# MODELS_EXTRA=[{"id":"qwen3.6:35b-a3b","label":"Qwen 3.6","hint":"Local (CPU), MoE A3B","provider":"qwen","baseUrl":"http://ollama:11434/v1","reasoningTag":"think"}]

# Which model is the deployment default (everyone gets it, non-revocable).
# Must be a known id; unset = the first catalog entry.
# DEFAULT_MODEL_ID=claude-sonnet-5

# --- Auth ---
# Encrypts the JWE bearer tokens. Generate with: openssl rand -base64 48
JWT_SECRET=

# Server-level Windmill token used ONLY to call the LDAPS auth route
# (POST $WINDMILL_BASE_URL/api/r/<WINDMILL_KAUTH_ROUTE>) — users have no
# Windmill token of their own before logging in. Everything else stays
# per-user.
WINDMILL_AUTH_TOKEN=
# Name of the Windmill HTTP route serving the k-auth contract (default k-auth).
# WINDMILL_KAUTH_ROUTE=k-auth

# --- StarRocks (data warehouse; MySQL wire protocol, FE query port) ---
STARROCKS_HOST=localhost
STARROCKS_PORT=9030
STARROCKS_DATABASE=

# --- Windmill (optional — skipped when unset) ---
# Instance location only. Auth is PER USER: each user stores their own
# Windmill token (User settings → Tokens) in the app under
# Settings → Connectors, so MCP tools and runPython execute with that
# user's own Windmill permissions.
WINDMILL_BASE_URL=https://windmill.example.com
WINDMILL_WORKSPACE=

# Tabula documentation platform MCP endpoint. Each user stores their own
# Tabula API token in Settings, so doc access follows their permissions.
TABULA_MCP_URL=https://docs.example.com/api/mcp

# --- App state ---
# Where conversations/documents/exports live. Defaults: ./data (host dev),
# /app/data in Docker (the compose volume). Don't leave these set but empty.
# DATA_DIR=

# Synced warehouse schema injected into the agent's system prompt.
# Defaults: ./schema.json (host dev), /app/data/schema.json in Docker.
# Host dev: STARROCKS_SYNC_USER=<u> STARROCKS_SYNC_PASSWORD=<p> npm run sync-schema
# Docker:   one-off  -> docker compose exec perguntai node scripts/sync-schema.js
#           periodic -> docker compose --profile sync up -d (schema-sync sidecar,
#           re-syncs daily; needs the two credentials below)
# Databases to include in the catalog: comma-separated, where each entry is a
# literal name, a glob ("dm_*"), or "all"/"*" for every non-system database the
# sync user can see. E.g. "gold,dm_*" = gold plus every datamart, no hand-listing.
# Globs/"all" are resolved against SHOW DATABASES using the sync account's grants.
# Default = STARROCKS_DATABASE. Names are shown database-qualified. The catalog
# is served via the listTables tool (not the system prompt) and is filtered
# per-user at runtime to the databases each user's StarRocks grants can see.
# STARROCKS_SYNC_DATABASES=gold,dm_*
# SCHEMA_PATH=
# STARROCKS_SYNC_USER=
# STARROCKS_SYNC_PASSWORD=

# --- Deployment ---
# Public URL of the app (optional — used for absolute URL generation; the
# origin-based CSRF check is disabled since auth is bearer-header-only).
# Do NOT leave it set but empty.
# ORIGIN=https://perguntai.example.com

# URL of the app AS SEEN FROM WINDMILL WORKERS — activated flows with agent
# steps call back into POST /api/flows/agent-step. Falls back to ORIGIN.
# Use the internal service URL when both run in the same cluster.
# PERGUNTAI_BASE_URL=http://perguntai.perguntai.svc.cluster.local:3000

# Shared secret to trigger the schema-sync route (POST /api/admin/sync-schema)
# from a Windmill cron: the caller sends `Authorization: Bearer <this>`. Leave
# empty to disable the secret path (an admin session can still trigger it).
# Generate with: openssl rand -base64 32
# SCHEMA_SYNC_TOKEN=

# Bootstrap admin(s): comma-separated usernames that are ALWAYS admins and
# always allowed — the safety net so an admin can't lock themselves out.
# Everything else (allowlist, roles, blocks, token limits) is managed at
# runtime in the app's admin panel (Settings → Admin), stored in
# DATA_DIR/access.json.
ADMIN_USERS=

# Legacy allowlist (optional): imported into access.json on first boot, then
# superseded by the admin panel. Empty list = everyone with valid
# StarRocks/LDAPS credentials may sign in.
# ALLOWED_USERS=machadoleo,alice,bob

# --- Sentry (observability / AI-agent monitoring). Optional: leave SENTRY_DSN
#     empty to disable. The DSN is a public key (safe to share), not a secret.
#     SENTRY_AUTH_TOKEN is only needed later for source-map upload. ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=1.0
