# --- LLM: Claude via Azure AI Foundry (Sonnet 5 default; Opus 4.8 / Fable 5) ---
# Option A (preferred): Microsoft Azure AI Foundry.
# Must end in /anthropic/v1 — the provider appends /messages to it.
ANTHROPIC_FOUNDRY_BASE_URL=https://<resource>.services.ai.azure.com/anthropic/v1
ANTHROPIC_FOUNDRY_API_KEY=

# Option B (fallback, used when the Foundry URL is unset): direct Anthropic API
ANTHROPIC_API_KEY=

# --- Extra models (any OpenAI-compatible /v1 endpoint: Ollama, OpenAI, Groq,
#     vLLM, OpenRouter, Gemini's compat endpoint, …) ---
# JSON array; each entry: id (app-unique), label, and for openai-compatible
# entries a baseUrl. Optional: hint (picker subtitle), provider (logo family:
# anthropic/openai/google/qwen/ollama, else generic), model (upstream name when
# it differs from id), apiKey or apiKeyEnv (name of the env var holding the
# key — Ollama needs neither), reasoningTag ("think" extracts <think>…</think>
# from reasoning models like Qwen/DeepSeek so the UI shows it as thinking),
# maxOutputTokens (per-request output ceiling; default 8192 for
# openai-compatible entries — a runaway reasoning loop on CPU churns for
# minutes otherwise — and 32000 for anthropic ones).
# The built-in Claude entries appear only when Anthropic credentials are set
# above; MODELS_EXTRA entries are appended after them.
# MODELS_EXTRA=[{"id":"qwen3.6:35b-a3b","label":"Qwen 3.6","hint":"Local (CPU), MoE A3B","provider":"qwen","baseUrl":"http://ollama:11434/v1","reasoningTag":"think"}]

# Which model is the deployment default (everyone gets it, non-revocable).
# Must be a known id; unset = the first catalog entry.
# DEFAULT_MODEL_ID=claude-sonnet-5

# --- Auth ---
# Encrypts the JWE bearer tokens. Generate with: openssl rand -base64 48
JWT_SECRET=

# Character cap for the organization-wide system prompt edited in /organization
# (server-enforced on save; the console textarea mirrors it). Default: 8000.
# MAX_ORG_PROMPT=8000

# Two doors, either or both: SSO (OIDC against authentik) and username +
# password (LDAPS). Both yield the same session and the same profile claims
# (`groups` → memberOf for department matching), so admin rules match a person
# the same way whichever they use. The login page draws what is configured.

# OIDC: authorization code + PKCE. The provider must register
#   <ORIGIN>/auth/callback   as a redirect URI, and
#   <ORIGIN>/login           as a post-logout redirect.
# The id_token also authenticates warehouse queries (StarRocks
# `authentication_jwt`), minted per connection from the stored refresh token —
# keep `offline_access` in the scopes.
# OIDC_ISSUER=https://authentik.example.com/application/o/perguntai/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=                     # omit for a public client
# OIDC_SCOPES="openid profile email offline_access"
# OIDC_TIMEOUT_MS=10000

# LDAP: the password is verified by a bind over LDAPS, and — since there is no
# refresh token — travels inside the encrypted session so warehouse queries can
# use StarRocks' native/LDAP authentication for that user (the pre-OIDC model).
# Setting LDAP_URL enables the form. Two strategies:
#   service account (preferred): bind as LDAP_BIND_DN, find the user with
#     LDAP_USER_FILTER, bind again as that DN. Works on AD and OpenLDAP.
#   direct: no LDAP_BIND_DN — bind as <username>@LDAP_DOMAIN (AD accepts a UPN).
# People may type `jdoe`, `DOMAIN\jdoe` or `jdoe@domain`; all resolve the same.
# LDAP_URL=ldaps://dc01.example.com:636
# LDAP_BIND_DN="svc-perguntai@example.com"   # a UPN or full DN
# LDAP_BIND_PASSWORD=
# LDAP_DOMAIN=example.com                    # UPN suffix for the direct strategy
# LDAP_BASE_DN="DC=example,DC=com"           # default: the server's defaultNamingContext
# LDAP_USER_FILTER="(sAMAccountName={{username}})"   # {{username}} is escaped for you
# LDAP_USERNAME_ATTR=sAMAccountName
# LDAP_GROUP_ATTR=memberOf                   # becomes the profile's memberOf (DN and CN forms)
# LDAP_NESTED_GROUPS=false                   # AD only: also resolve groups-of-groups
# Extra claims as claim=attribute pairs (defaults: name=displayName, email=mail,
# title, employee_id=employeeID). Cost-centre rules read these two:
# LDAP_CLAIMS="cost_center=extensionAttribute1,cost_center_description=extensionAttribute2"
# LDAP_CA_CERT=/etc/ssl/certs/corp-root.pem  # PEM bundle if the server cert is private
# LDAP_TLS_REJECT_UNAUTHORIZED=true          # false trusts any server certificate
# LDAP_TIMEOUT_MS=10000

# --- Embeddings (optional — retrieval upgrade for uploaded documents) ---
# Any OpenAI-compatible /embeddings endpoint. When set, uploads are embedded and
# document search becomes hybrid (BM25 + cosine, rank-fused); unset, retrieval
# is lexical BM25 exactly as before. Documents stored before this was set (or
# with a different model) keep working lexically — re-upload to embed them.
#   Azure OpenAI:  EMBEDDINGS_BASE_URL=https://<resource>.openai.azure.com/openai/v1
#   Ollama:        EMBEDDINGS_BASE_URL=http://ollama-host:11434/v1  (e.g. model bge-m3)
# EMBEDDINGS_BASE_URL=
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_TIMEOUT_MS=30000

# --- StarRocks (data warehouse; MySQL wire protocol, FE query port) ---
STARROCKS_HOST=localhost
STARROCKS_PORT=9030
STARROCKS_DATABASE=

# --- App state ---
# Where conversations/documents/exports live. Defaults: ./data (host dev),
# /app/data in Docker (the compose volume). Don't leave these set but empty.
# DATA_DIR=

# Synced warehouse schema injected into the agent's system prompt.
# Defaults: ./schema.json (host dev), /app/data/schema.json in Docker.
# Host dev: STARROCKS_SYNC_USER=<u> STARROCKS_SYNC_PASSWORD=<p> npm run sync-schema
# Docker:   one-off  -> docker compose exec perguntai node scripts/sync-schema.js
#           periodic -> docker compose --profile sync up -d (schema-sync sidecar,
#           re-syncs daily; needs the two credentials below)
# Databases to include in the catalog: comma-separated, where each entry is a
# literal name, a glob ("dm_*"), or "all"/"*" for every non-system database the
# sync user can see. E.g. "gold,dm_*" = gold plus every datamart, no hand-listing.
# Globs/"all" are resolved against SHOW DATABASES using the sync account's grants.
# Default = STARROCKS_DATABASE. Names are shown database-qualified. The catalog
# is served via the listTables tool (not the system prompt) and is filtered
# per-user at runtime to the databases each user's StarRocks grants can see.
# STARROCKS_SYNC_DATABASES=gold,dm_*
# SCHEMA_PATH=
# STARROCKS_SYNC_USER=
# STARROCKS_SYNC_PASSWORD=

# --- Code execution (BETA, optional) ---
# Sandboxed Python on microsandbox microVMs. The feature also needs the admin
# toggle in /organization → Capacidades. Local backend requires /dev/kvm on
# this host (bare metal or nested virtualization); alternatively set MSB_API_KEY
# for the microsandbox cloud backend. All optional, with defaults:
# The custom image (deploy/sandbox/Dockerfile) preinstalls pandas/numpy/
# statsmodels/scikit-learn AND the basalt binary — build, push, and pin it here
# so runs never pip-install. The bare default works but has no analysis stack.
# MSB_IMAGE=ghcr.io/leonardomb1/perguntai-sandbox:v1
# MSB_MEMORY_MIB=512
# MSB_CPUS=1
# MSB_TIMEOUT_MS=60000
# MSB_WORKDIR=/home/perguntai
# MSB_API_KEY=

# --- Deployment ---
# Public URL of the app (optional — used for absolute URL generation; the
# origin-based CSRF check is disabled since auth is bearer-header-only).
# Do NOT leave it set but empty.
# ORIGIN=https://perguntai.example.com

# Shared secret to trigger the schema-sync route (POST /api/admin/sync-schema)
# from an external scheduler/cron: the caller sends `Authorization: Bearer <this>`. Leave
# empty to disable the secret path (an admin session can still trigger it).
# Generate with: openssl rand -base64 32
# SCHEMA_SYNC_TOKEN=

# Bootstrap admin(s): comma-separated usernames that are ALWAYS admins and
# always allowed — the safety net so an admin can't lock themselves out.
# Everything else (allowlist, roles, blocks, token limits) is managed at
# runtime in the app's admin panel (Settings → Admin), stored in
# DATA_DIR/access.json.
ADMIN_USERS=

# Legacy allowlist (optional): imported into access.json on first boot, then
# superseded by the admin panel. Empty list = everyone who signs in (SSO or
# LDAPS) may use the app.
# ALLOWED_USERS=machadoleo,alice,bob

# --- Sentry (observability / AI-agent monitoring). Optional: leave SENTRY_DSN
#     empty to disable. The DSN is a public key (safe to share), not a secret.
#     SENTRY_AUTH_TOKEN is only needed later for source-map upload. ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=1.0
# Dev servers stay silent even with a DSN set (avoids polluting the project and
# spurious SSR fetch warnings from async envelope uploads); SENTRY_DEV=1 opts in.
# SENTRY_DEV=1

# --- Embedded chat (/embed) — anonymous read-only chat for intranet portals ---
# Prefer per-portal EMBED KEYS minted in the console (Capacidades): each key
# carries its own StarRocks service account, limits and framing origins.
# The env account below is the keyless fallback for a single-portal setup.
# Enable in the console (Capacidades). The service account is the security
# boundary: create a dedicated StarRocks user granted ONLY curated views.
# EMBED_STARROCKS_USER=
# EMBED_STARROCKS_PASSWORD=
# Model for the embed surface (sonnet tier or lower; opus/fable are refused).
# EMBED_MODEL=claude-sonnet-5
# User messages per conversation before the visitor must reset (default 10).
# EMBED_MAX_MESSAGES=10
# Shared daily weighted-token budget for the whole surface (default 1000000).
# EMBED_DAILY_TOKENS=1000000
# Who may iframe /embed (CSP frame-ancestors; default 'self').
# EMBED_ALLOWED_ORIGINS='self' https://portal.example.com
